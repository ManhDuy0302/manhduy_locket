# Optional: folder that holds the SQLite database and uploaded photos.
# Defaults to ./.data inside the app.
LOCKET_DATA_DIR=

# Set to true when the app is served over https so the session cookie gets
# the Secure flag. Leave false for local / LAN testing over http.
COOKIE_SECURE=false

# Optional: send the 6-digit login codes as real text messages through Twilio.
# Leave these empty and the code is shown on the verification screen instead.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional: extra secret mixed into the hashed verification codes.
OTP_SECRET=

# ============ Real Locket account connector ============
# The app can talk to Locket's private iOS API (api.locketcamera.com) so a real
# Locket account shows up here. Every value below can also be pasted at
# /locket under "Server setup" and stored in the local database instead.
#
# Firebase Web API key of Locket's project (locket-4252a), starts with "AIza".
LOCKET_FIREBASE_API_KEY=
# X-Firebase-AppCheck JWT captured from the iOS app. It expires ~1 hour later.
LOCKET_APPCHECK_TOKEN=
# Firebase Instance ID token sent as "Firebase-Instance-ID-Token".
LOCKET_INSTANCE_ID_TOKEN=
# Optional override, defaults to https://api.locketcamera.com
LOCKET_API_BASE=
# Optional key that encrypts stored Firebase refresh tokens.
LOCKET_SECRET=

# Comma separated usernames allowed to edit the Locket server setup.
# When empty, the first account that signed up is treated as the owner.
ADMIN_USERNAMES=

# ============ Deployment ============
# Public URL, used for metadata / social previews.
NEXT_PUBLIC_SITE_URL=
# Set to true whenever the app is served over https.
COOKIE_SECURE=true

# First boot only: creates the owner account on an empty database and, when a
# refresh token is supplied, links the real Locket account automatically.
# Leave these unset on a machine that already has data.
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=
BOOTSTRAP_OWNER_NAME=
BOOTSTRAP_OWNER_USERNAME=
BOOTSTRAP_LOCKET_REFRESH_TOKEN=
